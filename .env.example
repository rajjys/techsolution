# ─── Formulaire de contact (Resend) ──────────────────────────────────────────
# Clé API : https://resend.com/api-keys
# Sans cette clé, l'entonnoir fonctionne en mode démo : la demande est
# consignée dans les logs serveur et le visiteur voit quand même la
# confirmation — la configuration ne doit jamais bloquer le parcours.
RESEND_API_KEY=

# Boîte de réception de l'équipe commerciale.
# Recette : testmail@techsolution.cd — Production : info@techsolution.cd
CONTACT_TO_EMAIL=testmail@techsolution.cd

# Expéditeur — après vérification du domaine techsolution.cd dans Resend,
# remplacer par : "Tech Solution RDC <devis@techsolution.cd>"
CONTACT_FROM_EMAIL="Tech Solution RDC <onboarding@resend.dev>"
