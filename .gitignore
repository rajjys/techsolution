# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# farde entreprise : contient les téléphones personnels des personnes de
# référence — ne pas versionner sur GitHub (git add -f pour forcer si repo privé)
docs/*.pdf

# état local de l'outillage Claude Code (permissions machine)
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Galerie photos/vidéos HD originales (142 Mo) — hors dépôt ; versions web optimisées uniquement
/public/gallery/

# Audits prospects (ne pas versionner)
Audit-pmultiples-*.pdf

# Archive photo brute (608 vues, 179 Mo) — hors dépôt.
# `web-optimized/` est la source haute qualité, `ai-preview/` sa version
# allégée pour l'analyse. Seule la sélection curatée de `public/photos/`
# est versionnée : c'est elle que le site consomme.
/public/ai-preview/
/public/web-optimized/
